# Literature search exports and deduplication outputs contain citation metadata
# and abstracts. Keep them local unless their redistribution is explicitly allowed.
/databases/
*.ris
*.nbib

# The protocol may be an unpublished working document; keep it local by default.
/protocol*.docx

